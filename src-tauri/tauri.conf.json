{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cepa",
  "version": "0.1.0",
  "identifier": "com.yunhocho.cepa",
  "build": {
    "beforeDevCommand": "bun --bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun --bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Cepa",
        "width": 880,
        "height": 620,
        "minWidth": 620,
        "minHeight": 480,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 16, "y": 20 },
        "center": false,
        "visible": false
      }
    ],
    "security": {
      "csp": {
        "default-src": ["'self'"],
        "connect-src": ["ipc:", "http://ipc.localhost"],
        "img-src": ["'self'"],
        "script-src": ["'self'"],
        "style-src": ["'self'"],
        "object-src": ["'none'"],
        "base-uri": ["'none'"],
        "frame-src": ["'none'"],
        "frame-ancestors": ["'none'"],
        "worker-src": ["'none'"]
      },
      "devCsp": {
        "default-src": ["'self'"],
        "connect-src": [
          "'self'",
          "ipc:",
          "http://ipc.localhost",
          "ws://localhost:1420"
        ],
        "img-src": ["'self'"],
        "script-src": ["'self'"],
        "style-src": ["'self'", "'unsafe-inline'"],
        "object-src": ["'none'"],
        "base-uri": ["'none'"],
        "frame-src": ["'none'"],
        "frame-ancestors": ["'none'"],
        "worker-src": ["'none'"]
      }
    }
  },
  "bundle": {
    "active": true,
    "publisher": "Cepa contributors",
    "homepage": "https://github.com/yunho-c/Cepa",
    "copyright": "Copyright © 2026 Cepa contributors",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "category": "Utility",
    "shortDescription": "Fast, private disk space analysis.",
    "longDescription": "Cepa is a fast, cross-platform disk space analyzer. Explore local storage through a coordinated radial map and ranked directory view; scanning stays on this device.",
    "targets": ["app", "dmg", "deb", "rpm", "appimage", "nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
